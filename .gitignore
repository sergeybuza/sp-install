# Локальное окружение и секреты
.env
.env.*
!.env.example
secrets/
*.key
*.p12
*.pfx

# Локальная поставка Docker-образов
/input/images/*
!/input/images/README.md
/input/highload/
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.tar.zst

# Рабочие данные, логи и резервные копии
/data/
/logs/
/backups/
/outputs/
/node_modules
/deploy/config/highload/*.xlsx
!/deploy/config/highload/test_sp_local.xlsx
/reports/*
!/reports/README.md
*.log
__pycache__/

# Временные файлы редакторов и ОС
.DS_Store
*~
*.swp
*.swo
.idea/
.vscode/
